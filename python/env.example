# TheBrain MCP Server Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Your TheBrain API key
# Get it from TheBrain Settings > API
THEBRAIN_API_KEY=your_api_key_here

# OPTIONAL: Default brain ID to use if not specified
# Example: U01B02 or your specific brain UUID
THEBRAIN_DEFAULT_BRAIN_ID=

# OPTIONAL: Path to TheBrain local database directory
# Leave empty to use default locations:
#   Windows: %USERPROFILE%\Brains (e.g., C:\Users\YourName\Brains)
#   macOS: ~/Brains or ~/Library/Application Support/TheBrain
#   Linux: ~/Brains or ~/.local/share/thebrain
# 
# You can use environment variables in the path:
#   Windows: %USERPROFILE%\MyBrains or %APPDATA%\TheBrain\Brains
#   Unix/Mac: ~/MyBrains or $HOME/Documents/TheBrain
#
# Examples:
#   THEBRAIN_LOCAL_DB_PATH=C:\MyCustomPath\Brains
#   THEBRAIN_LOCAL_DB_PATH=/Users/me/Documents/MyBrains
#   THEBRAIN_LOCAL_DB_PATH=~/CustomBrains
THEBRAIN_LOCAL_DB_PATH=

# OPTIONAL: Enable local/hybrid mode for better performance
# Set to true to use local database when available
THEBRAIN_ENABLE_HYBRID_MODE=true

# OPTIONAL: Log level (DEBUG, INFO, WARNING, ERROR)
THEBRAIN_LOG_LEVEL=INFO
